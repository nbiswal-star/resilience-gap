# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose publishes the container on host port 5433)
RESGAP_DATABASE_URL=postgresql://resgap:resgap@localhost:5433/resgap
POSTGRES_USER=resgap
POSTGRES_PASSWORD=resgap
POSTGRES_DB=resgap

# Pipeline profile: "sample" (small, fast, default) or "full" (all states, 2000-2025)
RESGAP_PROFILE=sample

# Object storage for raw files and semi-structured JSON.
#   local -> filesystem directory with S3-style keys (default, no credentials).
#            Team setup: point RESGAP_LAKE_DIR at your synced copy of the shared Dropbox
#            folder, e.g. ~/Library/CloudStorage/Dropbox/resgap-lake
#   s3    -> any S3-compatible store (AWS S3, or SeaweedFS via `docker compose --profile s3 up`)
RESGAP_OBJECT_STORE=local
RESGAP_LAKE_DIR=./data/lake
RESGAP_S3_BUCKET=resgap-lake
RESGAP_S3_PREFIX=
# Leave empty for AWS S3; for SeaweedFS use http://localhost:8333
RESGAP_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# HTTP behaviour
RESGAP_HTTP_TIMEOUT_SECONDS=120
RESGAP_HTTP_USER_AGENT=resgap-pipeline/0.1 (95-815 course project)
